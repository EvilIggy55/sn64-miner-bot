# Copy to .env and fill in. Never commit .env: it holds passwords and tokens.
# Scripts read it; values already set in the environment take precedence.

# --- The bot (deploy_stack.sh stores these in the miner-bot-secrets Secret) ---
# ss58 address of your hotkey on the subnet in config/miner.yaml. Public; the bot needs no keys.
# (Formerly SN64_HOTKEY, which is still read if BT_HOTKEY is unset.)
BT_HOTKEY=
BT_NETWORK=finney
# Letters and digits only (it goes into a connection URL). Try: openssl rand -hex 24
POSTGRES_PASSWORD=
# Optional: Hugging Face token, needed only for gated models.
HF_TOKEN=

# --- scripts/register_hotkey.sh (run where your wallet lives) ---
WALLET_NAME=
WALLET_HOTKEY=

# --- scripts/install_gpu_node.sh (on each separate GPU host) ---
K3S_URL=https://CONTROL_NODE_IP:6443
# From the control node: sudo cat /var/lib/rancher/k3s/server/node-token
K3S_TOKEN=
# Use the version install_k3s.sh printed, so agents match the server.
K3S_VERSION=

# --- scripts/deploy_stack.sh ---
IMAGE=miner-bot:0.1.0
